  toggle.addEventListener('click',()=>{
    const open=menu.classList.toggle('open');
    toggle.setAttribute('aria-expanded',String(open));
    toggle.setAttribute('aria-label',open?'Cerrar menú':'Abrir menú');
  });
  menu.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>{
    menu.classList.remove('open');
    toggle.setAttribute('aria-expanded','false');
    toggle.setAttribute('aria-label','Abrir menú');
  }));

  document.querySelectorAll('.video-unit').forEach(unit=>{
    const input=unit.querySelector('input[type="file"]');
    const video=unit.querySelector('video');
    const sound=unit.querySelector('.sound-button');
    const status=unit.querySelector('.video-status');
    let objectUrl=null;
    input.addEventListener('change',()=>{
      const file=input.files && input.files[0];
      if(!file)return;
      if(!['video/mp4','video/webm','video/quicktime'].includes(file.type)){
        status.textContent='Elige un archivo de video MP4, WebM o MOV.';
        input.value='';
        return;
      }
      video.pause();
      if(objectUrl)URL.revokeObjectURL(objectUrl);
      objectUrl=URL.createObjectURL(file);
      video.src=objectUrl;
      video.muted=true;
      video.controls=true;
      video.load();
      unit.classList.add('loaded');
      sound.disabled=false;
      sound.textContent='Activar sonido';
      status.textContent='Video cargado: '+file.name;
      video.play().catch(()=>{ status.textContent='Video listo. Pulsa reproducir para verlo.'; });
    });
    video.addEventListener('error',()=>{
      status.textContent='No se pudo reproducir este archivo. Prueba con un MP4 compatible.';
    });
    sound.addEventListener('click',()=>{
      video.muted=!video.muted;
      sound.textContent=video.muted?'Activar sonido':'Silenciar';
      sound.setAttribute('aria-pressed',String(!video.muted));
    });
  });
  if(window.lucide)lucide.createIcons();
</script>
 
</body></html>
